{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "mobile",
  "description": "Android / iOS 权限：无窗口控制、无应用内自更新。生物识别、相机扫码、剪贴板等插件权限在接入对应插件时再加。",
  "platforms": [
    "iOS",
    "android"
  ],
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:event:default",
    "dialog:default"
  ]
}
