{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "git-account-manager",
  "version": "1.1.1",
  "identifier": "com.jeck.gitaccountmanager",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Git 多账号管理器",
        "width": 980,
        "height": 620,
        "minWidth": 840,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM3QkVGMDgxQkQ1OEFBNkMKUldSc3FsaTlnZkMreCtDZ0F4Y290SUM1d3lYemwzcjJuOVdEOXEwOGR3Zi9hSnJZMkdHREgzZ1cK",
      "endpoints": [
        "https://github.com/ice-juice/git-identity-manager-app/releases/latest/download/latest.json"
      ]
    }
  }
}
